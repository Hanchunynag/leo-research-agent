# Copy this file to .env. Never commit a real API key.

# OpenAI-compatible model used by CrewAI Manager and specialist agents.
LEO_LLM_BASE_URL=https://api.deepseek.com
LEO_LLM_MODEL=your-model-name
LEO_LLM_API_KEY=
# LEO_LLM_AUTH_SCHEME=bearer
LEO_LLM_JSON_MODE=true
LEO_LLM_MAX_TOKENS=8192
LEO_LLM_TIMEOUT_SECONDS=120
# LEO_LLM_PROMPT_LAYOUT=context_first

# CrewAI Scholar production runtime. The Worker is the only Agent executor.
LEO_SCHOLAR_RUNTIME_MODE=production
LEO_SCHOLAR_MAX_MANAGER_STEPS=12
# LEO_SCHOLAR_RESEARCH_MAX_CONCURRENCY=1

# Web/corpus retrieval configuration.
LEO_WEB_LOCAL_FILES_ONLY=true
LEO_WEB_EMBEDDING_MODEL=BAAI/bge-m3
# LEO_WEB_EMBEDDING_REVISION=
LEO_WEB_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# LEO_WEB_RERANKER_REVISION=
# LEO_WEB_DEVICE=mps
LEO_WEB_MODEL_CACHE=data/models/huggingface
LEO_WEB_EMBEDDING_BATCH_SIZE=8
LEO_WEB_RERANKER_BATCH_SIZE=4
LEO_WEB_RERANKER_MAX_LENGTH=1024

# Persistent Worker coordination.
# LEO_SCHOLAR_RETRY_BACKOFF_SECONDS=1.0
# LEO_SCHOLAR_RETRY_BACKOFF_MAX_SECONDS=60.0
# LEO_SCHOLAR_RETRY_JITTER_SECONDS=0.25
# LEO_SCHOLAR_MAX_RUNNING_PER_SCOPE=1
# QDRANT_URL=http://127.0.0.1:6333
# QDRANT_API_KEY=

# Multi-user deployments should inject identity_resolver from authenticated
# middleware. Header bridging is disabled unless the gateway strips and
# rewrites these headers before forwarding requests.
# LEO_TRUSTED_IDENTITY_HEADERS=false

# Structured research facts/audit. Leave disabled for JSON/JSONL storage.
# LEO_MYSQL_ENABLED=true
# LEO_MYSQL_URL=mysql+pymysql://leo:password@127.0.0.1:3306/leo_research
# Keep this false whenever MySQL is enabled; silent JSON fallback can create
# split-brain reads and writes in production. It is irrelevant when MySQL is off.
LEO_MYSQL_FALLBACK_TO_JSON=false

# Parser/runtime overrides.
LEO_MINERU_EXECUTABLE=.venv-mineru/bin/mineru
LEO_PADDLEOCR_EXECUTABLE=.venv-paddleocr/bin/python
LEO_MAX_QUERY_VARIANTS=5
LEO_MAX_CROSS_QUERY_CANDIDATES=40
# LEO_HTTP_PORT=8000
# MYSQL_PASSWORD=replace-me
# MYSQL_ROOT_PASSWORD=replace-me

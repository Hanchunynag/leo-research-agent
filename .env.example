# Copy this file to .env. Never commit a real API key.
# Remote OpenAI-compatible example:
LEO_LLM_BASE_URL=https://api.deepseek.com
LEO_LLM_MODEL=your-model-name
LEO_LLM_API_KEY=
# 强制 OpenAI-compatible Provider 返回 JSON object；仅当本地服务不兼容时设为 false。
LEO_LLM_JSON_MODE=true
LEO_LLM_MAX_TOKENS=8192
# 也支持 DeepSeek 官方变量名；两者同时存在时优先 LEO_LLM_API_KEY。
# DEEPSEEK_API_KEY=

# Local Ollama example (no API key required):
# LEO_LLM_BASE_URL=http://127.0.0.1:11434
# LEO_LLM_MODEL=qwen3:8b

LEO_LLM_TIMEOUT_SECONDS=120
LEO_LLM_MAX_TOKENS=1200
# Optional global override: query_first or context_first.
# LEO_LLM_PROMPT_LAYOUT=context_first

# Agentic RAG 可选覆盖（CLI 参数优先）：
LEO_AGENTIC_CANDIDATE_LIMIT=20
LEO_AGENTIC_RERANK_TOP_K=8
LEO_AGENTIC_FINAL_TOP_K=5
LEO_AGENTIC_EVIDENCE_MMR_LAMBDA=0.75
LEO_AGENTIC_MAX_FINAL_EVIDENCE_PER_WORK=2
LEO_AGENTIC_MIN_FINAL_DIRECTNESS_GRADE=1
LEO_AGENTIC_MAX_RETRIEVAL_ROUNDS=2
LEO_AGENTIC_MAX_STRUCTURE_REPAIRS=1
LEO_AGENTIC_MAX_ANSWER_REPAIRS=1
# LEO_AGENTIC_MAX_TOTAL_LATENCY_MS=120000
LEO_AGENTIC_FAIL_CLOSED=true
LEO_AGENTIC_ALLOW_MODEL_DOWNLOADS=true
LEO_AGENTIC_RRF_K=60
LEO_AGENTIC_RERANKER_ENABLED=true
LEO_AGENTIC_SEMANTIC_VALIDATION_ENABLED=true
LEO_AGENTIC_SAME_TOPIC_THRESHOLD=0.75
LEO_AGENTIC_NEW_TOPIC_THRESHOLD=0.45
LEO_AGENTIC_SEMANTIC_WEIGHT=0.40
LEO_AGENTIC_ENTITY_WEIGHT=0.25
LEO_AGENTIC_CONTEXT_DEPENDENCY_WEIGHT=0.20
LEO_AGENTIC_EVIDENCE_OVERLAP_WEIGHT=0.15
LEO_AGENTIC_CONTEXT_COMPACTION_THRESHOLD=0.70
LEO_AGENTIC_MODEL_CONTEXT_WINDOW=32768
LEO_AGENTIC_RECENT_EVENTS_AFTER_COMPACTION=8
# LEO_AGENTIC_SESSION_DB_PATH=data/runtime/agentic_sessions.sqlite3

# FastAPI 长驻 Web Runtime（API Key 仍只使用上方 LEO_LLM_API_KEY）：
LEO_WEB_LOCAL_FILES_ONLY=true
LEO_WEB_EMBEDDING_MODEL=BAAI/bge-m3
# 留空时自动继承 data/index/dense_manifest.json 中的精确 revision。
# LEO_WEB_EMBEDDING_REVISION=
LEO_WEB_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# LEO_WEB_RERANKER_REVISION=
# LEO_WEB_DEVICE=mps
LEO_WEB_MODEL_CACHE=data/models/huggingface
LEO_WEB_EMBEDDING_BATCH_SIZE=8
LEO_WEB_RERANKER_BATCH_SIZE=4
LEO_WEB_RERANKER_MAX_LENGTH=1024

# Optional MinerU executable override retained for non-default installations.
LEO_MINERU_EXECUTABLE=.venv-mineru/bin/mineru
# Neo4j 5.26 LTS (never commit a real password)
LEO_NEO4J_URI=bolt://127.0.0.1:7687
LEO_NEO4J_USER=neo4j
LEO_NEO4J_PASSWORD=
LEO_GRAPH_DATABASE=neo4j
LEO_INDEX_REGISTRY_PATH=data/index/index_registry.sqlite3
LEO_LEXICAL_INDEX_PATH=data/index/lexical.sqlite3
LEO_GRAPH_EXTRACTION_MODEL=
LEO_GRAPH_EXTRACTION_CONCURRENCY=2
LEO_GRAPH_EXTRACTION_PROMPT_VERSION=1.0
LEO_GRAPH_ONTOLOGY_VERSION=1.0
LEO_COMMUNITY_PROMPT_VERSION=1.0
LEO_MAX_QUERY_VARIANTS=5
LEO_MAX_GRAPH_HOPS=2
LEO_MAX_GRAPH_PATHS=20
LEO_MAX_CROSS_QUERY_CANDIDATES=40
